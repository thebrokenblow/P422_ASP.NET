@model AddCatPage

<form method="post">

    <div class="form-group">
        <label class="control-label">Имя: </label>
        <input asp-for="@Model.Cat.Name" class="form-control" />

        @if (Model.ValidationAddCat.IncorrectName != null && Model.ValidationAddCat.IncorrectName.Length > 0)
            {
                <p class="text-danger">@Model.ValidationAddCat.IncorrectName</p>
            }
    </div>

    <div class="form-group">
        <label class="control-label">Возраст: </label>
        <input asp-for="@Model.Cat.Age" type="number" class="form-control" />

            @if (Model.ValidationAddCat.IncorrectAge != null && Model.ValidationAddCat.IncorrectAge.Length > 0)
            {
                <p class="text-danger">@Model.ValidationAddCat.IncorrectAge</p>
            }
        </div>

    <div class="form-group">
        <label class="control-label">Цвет: </label>
        <input asp-for="@Model.Cat.Color" class="form-control" />
    </div>

    <div class="form-group">
        <label class="control-label">Описание: </label>
        <input asp-for="@Model.Cat.Description" class="form-control" />
    </div>

    <div class="form-group">
        <label class="control-label">Ссылка на фотографию: </label>
        <input asp-for="@Model.Cat.UrlPhoto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>
