@model Cat

<form asp-action="Edit" method="post">

    <div class="form-group">
        <label class="control-label">Имя: </label>
        <input asp-for="@Model.Name" class="form-control" />
    </div>

    <div class="form-group">
        <label class="control-label">Возраст: </label>
        <input asp-for="@Model.Age" type="number" class="form-control" />
        </div>

    <div class="form-group">
        <label class="control-label">Цвет: </label>
        <input asp-for="@Model.Color" class="form-control" />
    </div>

    <div class="form-group">
        <label class="control-label">Описание: </label>
        <input asp-for="@Model.Description" class="form-control" />
    </div>

    <div class="form-group">
        <label class="control-label">Ссылка на фотографию: </label>
        <input asp-for="@Model.UrlPhoto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>
