@model ResponceIndexModel<Cat>

<div class="container">

    <form asp-controller="Home" asp-action="Index" method="get">
        <div class="input-group mb-3">
            <input type="hidden" asp-for="CurrentPage" />

            <input type="text" asp-for="SearchString" class="form-control" placeholder="Введите имя: " aria-label="Введите имя: " aria-describedby="basic-addon2">
            <div class="input-group-append">
                <button class="btn btn-outline-secondary" type="submit">Поиск</button>
            </div>
        </div>
    </form>

    @if (Model.Pets.Count > 0)
    {
        <div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var cat in Model.Pets)
            {
                <div class="col">
                    <div class="card h-100">
                        <img src="@cat.UrlPhoto" class="card-img-top" alt="@cat.Name"
                        style="object-fit: cover; height: 400px;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@cat.Name</h5>
                            <p class="card-text">@cat.Description</p>
                            <div class="d-flex justify-content-between">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@cat.Id" class="btn btn-primary mt-auto">Подробнее</a>
                                <a asp-controller="Home" asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-warning mt-auto">Редактировать</a>
                                <a asp-controller="Home" asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-danger mt-auto">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <nav>
            <ul class="pagination">

                <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                    <a asp-controller="Home" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage - 1)" class="page-link">Предыдущая</a>
                </li>

                @for (int pageNumber = 1; pageNumber <= Model.TotalPages && pageNumber <= 10; pageNumber++)
                {
                    <li class="page-item @(Model.CurrentPage == pageNumber ? "active" : string.Empty)">
                        <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }

                @if (Model.TotalPages > 10)
                {
                    <li class="page-item">
                        ...
                    </li>

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages - 1 ? "active" : string.Empty)">
                        <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.TotalPages - 1)">@(Model.TotalPages - 1)</a>
                    </li>

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "active" : string.Empty)">
                        <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                    <a asp-controller="Home" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage + 1)" class="page-link">Следущая</a>
                </li>
            </ul>
        </nav>
    }
    else
    {
        <h1 style="text-align: center">По вашему запросу ничего не найдено</h1>    
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('keydown', function (event) {

            console.log('[1] Скрипт загружен');

            if (event.target.tagName.toLowerCase() === 'input') {
                return;
            }

            if (event.key === 'ArrowLeft') {
                const prevItem = document.querySelector('.pagination .page-item:first-child');
                if (prevItem && !prevItem.classList.contains('disabled')) {
                    const link = prevItem.querySelector('a');
                    if (link) link.click();
                }
            } else if (event.key === 'ArrowRight') {
                const nextItem = document.querySelector('.pagination .page-item:last-child');
                if (nextItem && !nextItem.classList.contains('disabled')) {
                    const link = nextItem.querySelector('a');
                    if (link) link.click();
                }
            }
        });
    </script>
}
