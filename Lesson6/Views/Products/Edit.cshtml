@model Lesson6.Models.ProductEdit

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Текущее фото</label>
                @if (Model.PhotoBytes != null && Model.PhotoBytes.Length > 0)
                {
                    var base64 = Convert.ToBase64String(Model.PhotoBytes);
                    var mime = "image/jpeg";
                    <div>
                        <img src="data:@mime;base64,@base64" style="max-width:200px; max-height:200px;" />
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PhotoFileName))
                    {
                        <div class="text-muted">@Model.PhotoFileName</div>
                    }
                }
                else
                {
                    <span class="text-muted">Нет фото</span>
                }
            </div>

            <div class="form-group">
                <input asp-for="PhotoFile" type="file" accept="image/*" class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>