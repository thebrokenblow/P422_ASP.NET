@model Person

<div class="col">
    <div class="card h-100">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">Имя: @Model.FirstName</h5>
            <p class="card-text">Фамилия: @Model.LastName</p>
            <p class="card-text">Возраст: @Model.Age</p>
        </div>
    </div>
</div>