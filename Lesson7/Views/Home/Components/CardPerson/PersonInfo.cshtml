@model CardDetails

<div class="col">
    <div class="card h-100">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">Имя: @Model.Person.FirstName</h5>
            <p class="card-text">Фамилия: @Model.Person.LastName</p>
            <p class="card-text">Возраст: @Model.Person.Age</p>
            <a asp-controller="@Model.ControllerName" asp-action="@Model.ActionName">Перейти</a>
        </div>
    </div>
</div>